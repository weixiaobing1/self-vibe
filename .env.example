# ===== MindFlow 环境变量 =====
# 复制此文件为 .env 并填入真实值

# DeepSeek AI API Key（必填）
AI_API_KEY=sk-your-api-key-here

# JWT 签名密钥（必填，建议随机字符串）
JWT_SECRET=change-me-to-a-random-string

# MySQL 数据库密码
MYSQL_PASSWORD=123456

# ===== 以下端口可留默认值 =====
# MYSQL_PORT=3308
# REDIS_PORT=6379
# BACKEND_PORT=8080
# FRONTEND_PORT=80
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001

# ===== MinIO 对象存储（默认开发账号，生产请修改）=====
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
